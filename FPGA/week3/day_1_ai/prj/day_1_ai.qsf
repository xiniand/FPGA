set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6F17C8
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 256
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "16:52:34  JULY 23, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Standard Edition"
set_global_assignment -name VERILOG_FILE ../src/clk_div.v
set_global_assignment -name VERILOG_FILE ../src/traffic_fsm.v
set_global_assignment -name VERILOG_FILE ../src/seg_driver.v
set_global_assignment -name VERILOG_FILE ../src/top.v
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VERILOG -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_timing
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_symbol
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_signal_integrity
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_boundary_scan
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

# 时钟约束：50MHz 输入时钟
set_global_assignment -name SDC_FILE day_1_ai.sdc

# ================================================================
# 引脚分配 — AWC_C4 DVK 开发板 (EP4CE6F17C8, F256 BGA封装)
# 来源：工作区已有项目的已验证引脚分配
# ================================================================

# 系统时钟 50MHz（板载晶振）
set_location_assignment PIN_E1 -to clk_50M

# 复位按键（低电平有效）
set_location_assignment PIN_F8 -to rst_n

# 板载LED（高有效）- 4位
# set_location_assignment PIN_D16 -to light_ns[0]  # 复用为NS绿灯
# set_location_assignment PIN_F15 -to light_ns[1]  # 复用为NS黄灯
# set_location_assignment PIN_F16 -to light_ns[2]  # 复用为NS红灯
# set_location_assignment PIN_G15 -to light_ew[2]  # EW红灯

# 按键输入（低电平有效）
set_location_assignment PIN_E15 -to emergency
# set_location_assignment PIN_E16 -to ?           # key_left（备用）
# set_location_assignment PIN_M15 -to ?           # key_right（备用）
# set_location_assignment PIN_M16 -to ?           # key_iled（备用）

# 数码管段码（共阳极，低有效）
# DIG_0=B7 → a, DIG_1=A8 → b, DIG_2=A6 → c, DIG_3=B5 → d
# DIG_4=B6 → e, DIG_5=A7 → f, DIG_6=B8 → g, DIG_7=A5 → dp
set_location_assignment PIN_B7 -to seg[0]
set_location_assignment PIN_A8 -to seg[1]
set_location_assignment PIN_A6 -to seg[2]
set_location_assignment PIN_B5 -to seg[3]
set_location_assignment PIN_B6 -to seg[4]
set_location_assignment PIN_A7 -to seg[5]
set_location_assignment PIN_B8 -to seg[6]
set_location_assignment PIN_A5 -to seg[7]

# 数码管位选（共阳极，低有效）
# SEL0=A4 → dig[0](EW个位), SEL1=B4 → dig[1](EW十位)
# SEL2=A3 → dig[2](NS个位), SEL3=B3 → dig[3](NS十位)
set_location_assignment PIN_A4 -to dig[0]
set_location_assignment PIN_B4 -to dig[1]
set_location_assignment PIN_A3 -to dig[2]
set_location_assignment PIN_B3 -to dig[3]

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top