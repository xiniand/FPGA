# ****************************************************************************
# 时序约束文件 day_1_ai.sdc
# 功能：定义时钟约束和输入输出延迟
# ****************************************************************************

# 50MHz 主时钟约束
create_clock -name clk_50M -period 20.000 [get_ports clk_50M]

# 衍生时钟（仅用于分析，由内部逻辑生成）
# clk_1hz 和 clk_1khz 由内部分频产生，无需额外约束
