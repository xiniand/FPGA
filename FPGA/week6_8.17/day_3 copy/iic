        START   :begin

        end 
        TX_DATA :begin

        end 
        RX_DATA :begin

        end 
        TX_ACK  :begin

        end 
        RX_ACK  :begin

        end 
        STOP    :begin

        end  
        default:n_state = IDLE; 
    endcase


end



endmodule